<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="500.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="alfred.MainWindow"
            stylesheets="@styles.css">
    <children>
        <!-- ScrollPane: anchored to ALL sides (fills window except bottom bar) -->
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vvalue="1.0"
                    AnchorPane.topAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.bottomAnchor="45.0">
            <content>
                <VBox fx:id="dialogContainer" alignment="TOP_CENTER" />
            </content>
        </ScrollPane>

        <!-- TextField: anchored left, right, bottom (stretches horizontally) -->
        <TextField fx:id="userInput"
                   promptText="Type a message..."
                   onAction="#handleUserInput"
                   prefHeight="40.0"
                   AnchorPane.leftAnchor="5.0"
                   AnchorPane.rightAnchor="85.0"
                   AnchorPane.bottomAnchor="3.0" />

        <!-- Button: anchored right, bottom (stays fixed width) -->
        <Button fx:id="sendButton"
                text="Send"
                mnemonicParsing="false"
                onAction="#handleUserInput"
                prefHeight="40.0"
                prefWidth="75.0"
                AnchorPane.rightAnchor="5.0"
                AnchorPane.bottomAnchor="3.0" />
    </children>
</AnchorPane>
